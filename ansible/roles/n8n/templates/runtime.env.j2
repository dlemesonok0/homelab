DOMAIN={{ lookup('ansible.builtin.env', 'DOMAIN') }}
CERTBOT_EMAIL={{ lookup('ansible.builtin.env', 'CERTBOT_EMAIL') }}
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD={{ lookup('ansible.builtin.env', 'POSTGRES_PASSWORD') }}
N8N_ENCRYPTION_KEY={{ lookup('ansible.builtin.env', 'N8N_ENCRYPTION_KEY') }}
TZ={{ lookup('ansible.builtin.env', 'TZ') | default('UTC', true) }}
N8N_IMAGE=n8nio/n8n:1.92.2
R2_ENDPOINT={{ lookup('ansible.builtin.env', 'R2_ENDPOINT') | regex_replace('/+$', '') }}
R2_BUCKET={{ lookup('ansible.builtin.env', 'R2_BUCKET') }}
R2_ACCESS_KEY_ID={{ lookup('ansible.builtin.env', 'R2_ACCESS_KEY_ID') }}
R2_SECRET_ACCESS_KEY={{ lookup('ansible.builtin.env', 'R2_SECRET_ACCESS_KEY') }}
RESTIC_PASSWORD={{ lookup('ansible.builtin.env', 'RESTIC_PASSWORD') }}
RESTIC_REPOSITORY=s3:{{ lookup('ansible.builtin.env', 'R2_ENDPOINT') | regex_replace('/+$', '') }}/{{ lookup('ansible.builtin.env', 'R2_BUCKET') }}
AWS_ACCESS_KEY_ID={{ lookup('ansible.builtin.env', 'R2_ACCESS_KEY_ID') }}
AWS_SECRET_ACCESS_KEY={{ lookup('ansible.builtin.env', 'R2_SECRET_ACCESS_KEY') }}
AWS_DEFAULT_REGION=auto
AWS_REGION=auto

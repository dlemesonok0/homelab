# Public DNS name that points to this VPS (no protocol or path).
DOMAIN=n8n.example.com

# Public DNS name for the ntfy notification service.
NTFY_DOMAIN=push.example.com

# Used by Certbot for expiry notices and important account messages.
CERTBOT_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate once with: openssl rand -hex 32
# Never change this value after n8n credentials have been created.
N8N_ENCRYPTION_KEY=replace-with-a-64-character-random-hex-string

# n8n instance-owner API key for automatic Error Workflow provisioning.
N8N_API_KEY=

# Generate with: docker run --rm binwiederhier/ntfy:v2.26.3 token generate
# A valid token starts with tk_ and is exactly 32 characters long.
NTFY_TOKEN=
# Generate with: docker run -it --rm binwiederhier/ntfy:v2.26.3 user hash
# This bcrypt hash provisions the internal ntfy user; daily clients use NTFY_TOKEN.
NTFY_USER_PASSWORD_HASH=

# IANA timezone, for example Europe/Moscow or Asia/Krasnoyarsk.
TZ=UTC

# Pin images to tested releases. Upgrade deliberately; see README.
N8N_IMAGE=n8nio/n8n:2.34.6
NETDATA_IMAGE=netdata/netdata:v2.11.0

# Base64-encoded rclone.conf containing a remote named "yadisk".
# It is created once with rclone config; see docs/02-infisical-and-github.ru.md.
RCLONE_CONFIG_B64=
# Generate once: openssl rand -base64 48. Losing it makes backups unrecoverable.
RESTIC_PASSWORD=


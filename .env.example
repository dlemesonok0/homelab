# Public DNS name that points to this VPS (no protocol or path).
DOMAIN=n8n.example.com

# Used by Certbot for expiry notices and important account messages.
CERTBOT_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate once with: openssl rand -hex 32
# Never change this value after n8n credentials have been created.
N8N_ENCRYPTION_KEY=replace-with-a-64-character-random-hex-string

# IANA timezone, for example Europe/Moscow or Asia/Krasnoyarsk.
TZ=UTC

# Pin n8n to a tested release. Upgrade deliberately; see README.
N8N_IMAGE=n8nio/n8n:1.92.2

# S3-compatible offsite backup repository. Cloudflare R2 example:
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=n8n-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generate once: openssl rand -base64 48. Losing it makes backups unrecoverable.
RESTIC_PASSWORD=
